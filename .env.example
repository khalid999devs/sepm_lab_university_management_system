# Local lab configuration. Copy this file to .env.
# Use plain KEY=value entries, without shell exports or quotation marks.
DB_NAME=ums
DB_USER=ums
DB_PASSWORD=ums-local-demo
DB_PORT=15432
PORT=8080

# Seeded only when the demo profile starts with an empty database.
DEMO_ADMIN_PASSWORD=AdminPass123
DEMO_TEACHER_PASSWORD=TeacherPass123
DEMO_STUDENT_PASSWORD=StudentPass123

# Optional pgAdmin browser UI; these credentials are separate from the database.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin-local-demo
PGADMIN_PORT=5050
